# 环境变量样例：只列键名与说明，严禁写入任何真实值
# 用法：cp .env.example .env 后自行填写（.env 已被 .gitignore 排除）

# LLM：按供应商填写，**全部留空也能跑通**（自动落到 Fake 脚本模型）
# --provider auto 的探测顺序：deepseek -> openai -> qwen -> zhipu -> anthropic
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
ZHIPUAI_API_KEY=
ANTHROPIC_API_KEY=

# 模型与端点（留空则用所选供应商的默认模型 / 官方端点）
ZKAGENT_PROVIDER=auto
ZKAGENT_MODEL_ID=
# 自建网关 / 本地 vLLM / LM Studio 等 OpenAI 兼容端点，例如 http://localhost:8000/v1
ZKAGENT_BASE_URL=

# 可观测（默认关闭；不设置也能跑完整评估）
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# HITL 审批人（P4 起使用；形如 alice:<token>,bob:<token>）
# 未设置时进入单机开发模式，审批记录会标记 approver_mode=dev_unauthenticated
HITL_APPROVERS=

# 运行期配置
ZKAGENT_INDUSTRY=appliance
ZKAGENT_DB_PATH=data/business.db
